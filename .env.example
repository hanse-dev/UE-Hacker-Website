# Copy to .env and adjust. Never commit .env.

# Required for admin UI at /admin
ADMIN_PASSWORD=change-me-admin

# API needs Node.js >= 22 (uses built-in node:sqlite)

# Never set DEV_SKIP_ADMIN_LOGIN here (only `npm run start:all:skip-checks` does);
# with NODE_ENV=production (Docker) the server refuses to start.

# Optional: signing secret for admin/user tokens (defaults to ADMIN_PASSWORD)
# SESSION_SECRET=another-long-random-string

# Port (dev API default 3001; prod / start:prod / Docker: 8080)
API_PORT=3001
# STATIC_DIR=./dist
# DATA_DIR=./api/data
# DB_PATH=./api/data/ue-hacker.sqlite
