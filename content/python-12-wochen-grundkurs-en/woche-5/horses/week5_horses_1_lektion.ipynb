    "def greet_ranch():\n",
    "    \"\"\"Greets visitors at the riding ranch\"\"\"\n",
    "    print(\"Welcome to Sunny Valley Riding Ranch!\")\n",
    "    print(\"Your training starts now!\")\n",
    "\n",
    "# Call the function\n",
    "print(\"=== First visitor ===\")\n",
    "greet_ranch()\n",
