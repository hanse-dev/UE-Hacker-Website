# Kopieren nach .env und ausfüllen. .env ist gitignored, nie committen.

# Domain des Produktions-Servers, auf dem der Account angelegt wird
ACCOUNT_SERVER_URL=https://deine-domain.example

# Admin-Passwort der Website (dasselbe wie im Admin-Login im Browser).
# Kann auch leer bleiben — dann fragt das Skript interaktiv danach (nicht sichtbar beim Tippen).
ADMIN_PASSWORD=

# Bluetooth-MAC-Adresse des Thermodruckers (Format XX:XX:XX:XX:XX:XX).
# Suche nach einem Gerät namens "MX01W" — siehe README im vendor/mxw01-Ordner nach dem Setup.
MXW01_PRINTER_ADDRESS=
