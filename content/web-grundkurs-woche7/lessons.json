      {
        "instruction": "Die Spalte soll die Items waagerecht in die Mitte schieben. Bei flex-direction: column ist dafür die andere Eigenschaft zuständig – tausche sie.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      gap: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><button>Spielen</button><button>Optionen</button><button>Beenden</button></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><button>Spielen</button><button>Optionen</button><button>Beenden</button></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".spalte",
              "property": "align-items",
              "value": "center",
              "hint": "Bei einer Spalte ist waagerecht die Querachse – dafür ist align-items zuständig."
            }
          ]
        }
      }
    ]
