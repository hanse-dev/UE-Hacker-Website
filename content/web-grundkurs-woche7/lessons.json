        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .punkt {\n      display: flex;\n      padding: 6px;\n    }\n  </style>\n</head>\n<body>\n  <nav class=\"leiste\"><a class=\"punkt\" href=\"#\">Start</a><a class=\"punkt\" href=\"#\">Blog</a><a class=\"punkt\" href=\"#\">Über mich</a></nav>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .leiste {\n      display: flex;\n    }\n    .punkt {\n      padding: 6px;\n    }\n  </style>\n</head>\n<body>\n  <nav class=\"leiste\"><a class=\"punkt\" href=\"#\">Start</a><a class=\"punkt\" href=\"#\">Blog</a><a class=\"punkt\" href=\"#\">Über mich</a></nav>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".leiste",
              "property": "display",
              "value": "flex",
