    "file": "mission-01.md",
    "lessonSummary": "Mission erfüllt! Kopfzeile, Kartenreihe und Fußzeile – alles mit Flexbox.",
    "tasks": [
      {
        "instruction": "Gestalte die Startseite mit allem aus der Liste oben.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    /* Dein CSS */\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Spieleabend</h1>\n    <nav><a href=\"#\">Spiele</a><a href=\"#\">Termine</a><a href=\"#\">Anmeldung</a></nav>\n  </header>\n  <main class=\"karten\">\n    <div class=\"karte\"><h2>Brettspiele</h2><p>Siedler, Carcassonne, Azul</p></div>\n    <div class=\"karte\"><h2>Kartenspiele</h2><p>Uno, Wizard, Skyjo</p></div>\n    <div class=\"karte\"><h2>Konsole</h2><p>Mario Kart und Smash</p></div>\n  </main>\n  <footer><p>Jeden ersten Freitag im Monat</p></footer>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n    nav {\n      display: flex;\n      gap: 12px;\n    }\n    .karten {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n    .karte {\n      flex: 1;\n      min-width: 140px;\n      background-color: lightyellow;\n      padding: 10px;\n    }\n    footer {\n      display: flex;\n      justify-content: center;\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Spieleabend</h1>\n    <nav><a href=\"#\">Spiele</a><a href=\"#\">Termine</a><a href=\"#\">Anmeldung</a></nav>\n  </header>\n  <main class=\"karten\">\n    <div class=\"karte\"><h2>Brettspiele</h2><p>Siedler, Carcassonne, Azul</p></div>\n    <div class=\"karte\"><h2>Kartenspiele</h2><p>Uno, Wizard, Skyjo</p></div>\n    <div class=\"karte\"><h2>Konsole</h2><p>Mario Kart und Smash</p></div>\n  </main>\n  <footer><p>Jeden ersten Freitag im Monat</p></footer>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": "header",
              "property": "display",
              "value": "flex",
              "hint": "Die Kopfzeile braucht display: flex;"
            },
            {
              "selector": "header",
              "property": "justify-content",
              "value": "space-between",
              "hint": "Titel links, Menü rechts: justify-content: space-between;"
            },
            {
              "selector": "header",
              "property": "align-items",
              "value": "center",
              "hint": "Titel und Menü senkrecht mittig: align-items: center;"
            },
            {
              "selector": "nav",
              "property": "display",
              "value": "flex",
              "hint": "Das Menü braucht display: flex;"
            },
