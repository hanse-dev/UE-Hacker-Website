    "lessonSummary": "Mission erfüllt! Deine Galerie sieht auf jedem Bildschirm gut aus.",
    "tasks": [
      {
        "instruction": "Baue deine Galerie-Seite mit allem aus der Liste oben.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n</head>\n<body>\n  <!-- Deine Galerie-Seite -->\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Meine Website</title>\n  <style>\n    .galerie {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n      gap: 8px;\n    }\n    .galerie img {\n      max-width: 100%;\n    }\n    .highlight {\n      grid-column: span 2;\n    }\n    @media (max-width: 600px) {\n      h1 {\n        font-size: 24px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <h1>Tierwelt</h1>\n  <div class=\"galerie\">\n    <img class=\"highlight\" src=\"/web-bilder/pferd.svg\" alt=\"Ein Pferd\">\n    <img src=\"/web-bilder/katze.svg\" alt=\"Eine Katze\">\n    <img src=\"/web-bilder/hund.svg\" alt=\"Ein Hund\">\n    <img src=\"/web-bilder/fisch.svg\" alt=\"Ein Fisch\">\n    <img src=\"/web-bilder/vogel.svg\" alt=\"Ein Vogel\">\n    <img src=\"/web-bilder/dino.svg\" alt=\"Ein Dino\">\n  </div>\n</body>\n</html>",
        "validation": {
          "type": "web",
