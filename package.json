{
  "name": "ue-hacker-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run pack:notebooks && vite",
    "build": "vite build",
    "preview": "vite preview",
    "cheatsheet:notebooks": "python3 scripts/md_to_cheatsheet_notebook.py",
    "pack:notebooks": "python3 scripts/pack_notebooks.py",
    "watch:notebooks": "node scripts/watch_notebooks.js",
    "prebuild": "npm run pack:notebooks",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:checks": "playwright test tests/week-checks-logic.spec.js tests/week-checks.spec.js tests/site.spec.js",
    "test:precommit": "npm run test:checks",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "marked": "^9.0.0",
    "pyodide": "^0.29.0",
    "vue": "^3.5.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
