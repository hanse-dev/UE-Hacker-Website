    "print(\"\\n=== Second visitor ===\")\n",
    "greet_ranch()\n",
    "\n",
    "print(\"\\n=== What happens here? ===\")\n",
    "print(\"1. def greet_ranch(): defines the function\")\n",
    "print(\"2. greet_ranch() calls the function\")\n",
    "print(\"3. The code inside the function is executed every time\")"
   ]
