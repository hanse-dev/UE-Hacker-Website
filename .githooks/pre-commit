#!/usr/bin/env sh
# Pre-commit: läuft nur die Playwright-Specs, die zu den staged Dateien passen
# (scripts/test-changed.mjs) — schnelles Feedback pro Commit. Der volle
# test:checks-Lauf ist stattdessen Pflicht vor dem Push (siehe .githooks/pre-push).
# Skip once with:  SKIP_CHECKS=1 git commit ...
# Or bypass hooks: git commit --no-verify

if [ "$SKIP_CHECKS" = "1" ] || [ "$SKIP_CHECKS" = "true" ]; then
  echo "⏭  SKIP_CHECKS set — Playwright checks skipped."
  exit 0
fi

echo "▶  Running npm run test:precommit (nur betroffene Specs) …"
npm run test:precommit
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "✖  Checks failed — commit aborted."
  echo "   Fix the failures, or skip with: SKIP_CHECKS=1 git commit …"
  echo "   (First time? npx playwright install chromium)"
  exit $status
fi

echo "✔  Checks passed."
exit 0
