[
  {
    "id": "lektion-01",
    "section": "lektion",
    "title": "Jedes Element ist eine Box",
    "file": "lektion-01.md",
    "lessonSummary": "Verstanden! Inhalt, Innenabstand, Rahmen und Außenabstand kannst du jetzt gezielt einsetzen.",
    "tasks": [
      {
        "instruction": "Führe das Beispiel aus. Die erste Box hat nur einen Rahmen, die zweite zusätzlich Innen- und Außenabstand.",
        "example": true,
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .ohne, .box {\n      border: 3px solid teal;\n      background-color: azure;\n    }\n    .box {\n      padding: 20px;\n      margin: 16px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"ohne\">Ohne Abstände</div>\n  <div class=\"box\">Mit padding und margin</div>\n</body>\n</html>\n",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".box",
              "property": "padding-top",
              "value": "20px"
            }
          ]
        }
      },
      {
        "instruction": "Gib allen Elementen mit class=\"hinweis\" einen Rahmen, Innenabstand an allen Seiten und unten einen Außenabstand (margin-bottom).",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .hinweis {\n      background-color: lightyellow;\n    }\n  </style>\n</head>\n<body>\n  <p class=\"hinweis\">Training fällt heute aus.</p>\n  <p class=\"hinweis\">Nächste Woche ist Turnier.</p>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .hinweis {\n      background-color: lightyellow;\n      border: 2px solid gold;\n      padding: 12px;\n      margin-bottom: 24px;\n    }\n  </style>\n</head>\n<body>\n  <p class=\"hinweis\">Training fällt heute aus.</p>\n  <p class=\"hinweis\">Nächste Woche ist Turnier.</p>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".hinweis",
              "property": "border-top-style",
              "notValue": "none",
              "min": 2,
              "hint": "Gib .hinweis einen Rahmen, z. B. border: 2px solid gold;"
            },
            {
              "selector": ".hinweis",
              "property": "padding-left",
              "notValue": "0px",
              "min": 2,
              "hint": "Gib .hinweis Innenabstand an allen Seiten, z. B. padding: 12px;"
            },
            {
              "selector": ".hinweis",
              "property": "margin-bottom",
              "notValue": "16px",
              "min": 2,
              "hint": "Ändere den Außenabstand unten, z. B. margin-bottom: 24px; (ein Absatz hat von Haus aus 16px)."
            }
          ]
        }
      },
      {
        "instruction": "Gib der Überschrift nur unten einen dicken Rahmen (border-bottom) und oben und unten 10px, links und rechts 30px Innenabstand – mit der Kurzschreibweise padding: 10px 30px;",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    /* Regel für h2 */\n  </style>\n</head>\n<body>\n  <h2>Neuigkeiten</h2>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    h2 {\n      border-bottom: 6px solid tomato;\n      padding: 10px 30px;\n    }\n  </style>\n</head>\n<body>\n  <h2>Neuigkeiten</h2>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": "h2",
              "property": "border-bottom-style",
              "notValue": "none",
              "hint": "Gib h2 einen Rahmen nur unten: border-bottom: 6px solid tomato;"
            },
            {
              "selector": "h2",
              "property": "border-top-style",
              "value": "none",
              "hint": "Oben soll kein Rahmen sein – nimm border-bottom statt border."
            },
            {
              "selector": "h2",
              "property": "padding-top",
              "value": "10px",
              "hint": "Oben soll der Innenabstand 10px sein: padding: 10px 30px;"
            },
            {
              "selector": "h2",
              "property": "padding-left",
              "value": "30px",
              "hint": "Links soll der Innenabstand 30px sein: padding: 10px 30px;"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "lektion-02",
    "section": "lektion",
    "title": "Breite, Höhe und box-sizing",
    "file": "lektion-02.md",
    "lessonSummary": "Exakt! Mit box-sizing: border-box ist eine Box genau so breit, wie du sagst.",
    "tasks": [
      {
        "instruction": "Führe das Beispiel aus: Beide Karten haben width: 200px – aber nur die zweite ist wirklich 200px breit.",
        "example": true,
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      width: 200px;\n      padding: 20px;\n      border: 5px solid navy;\n      margin-bottom: 10px;\n    }\n    .rand {\n      box-sizing: border-box;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\">content-box</div>\n  <div class=\"karte rand\">border-box</div>\n</body>\n</html>\n",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".rand",
              "property": "box-sizing",
              "value": "border-box"
            }
          ]
        }
      },
      {
        "instruction": "Die Karten sollen genau 180px breit sein, obwohl sie Innenabstand und Rahmen haben. Ergänze die passende Angabe.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      width: 180px;\n      padding: 15px;\n      border: 4px solid purple;\n      margin-bottom: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\">Karte 1</div>\n  <div class=\"karte\">Karte 2</div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      box-sizing: border-box;\n      width: 180px;\n      padding: 15px;\n      border: 4px solid purple;\n      margin-bottom: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\">Karte 1</div>\n  <div class=\"karte\">Karte 2</div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".karte",
              "property": "box-sizing",
              "value": "border-box",
              "min": 2,
              "hint": "Ergänze box-sizing: border-box; in .karte."
            },
            {
              "selector": ".karte",
              "property": "width",
              "value": "180px",
              "min": 2,
              "hint": "Die Breite soll bei 180px bleiben."
            }
          ]
        }
      },
      {
        "instruction": "Schalte border-box mit dem Universal-Selektor für alle Elemente ein und begrenze die Box mit class=\"artikel\" mit max-width auf 320px.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .artikel {\n      padding: 16px;\n      border: 2px solid gray;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"artikel\"><h2>Bericht</h2><p>Ein langer Bericht über unseren Ausflug ans Meer.</p></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n    .artikel {\n      max-width: 320px;\n      padding: 16px;\n      border: 2px solid gray;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"artikel\"><h2>Bericht</h2><p>Ein langer Bericht über unseren Ausflug ans Meer.</p></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": "h2, p, body",
              "property": "box-sizing",
              "value": "border-box",
              "min": 3,
              "hint": "Schreib eine Regel für alle Elemente: * { box-sizing: border-box; }"
            },
            {
              "selector": ".artikel",
              "property": "max-width",
              "value": "320px",
              "hint": "Ergänze in .artikel: max-width: 320px;"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "lektion-03",
    "section": "lektion",
    "title": "Zentrieren",
    "file": "lektion-03.md",
    "lessonSummary": "Mittig! Boxen und Text sitzen jetzt genau da, wo du sie haben willst.",
    "tasks": [
      {
        "instruction": "Führe das Beispiel aus: Die Box ist höchstens 300px breit und steht in der Mitte, der Text darin ist zentriert.",
        "example": true,
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .inhalt {\n      max-width: 300px;\n      margin: 0 auto;\n      text-align: center;\n      background-color: honeydew;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"inhalt\"><h2>Willkommen</h2><p>Schön, dass du da bist.</p></div>\n</body>\n</html>\n",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".inhalt",
              "property": "text-align",
              "value": "center"
            }
          ]
        }
      },
      {
        "instruction": "Zentriere die Box mit class=\"spalte\": höchstens 280px breit, links und rechts automatischer Außenabstand.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      background-color: mistyrose;\n      padding: 10px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><p>Ich soll in die Mitte!</p></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      background-color: mistyrose;\n      padding: 10px;\n      max-width: 280px;\n      margin: 0 auto;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><p>Ich soll in die Mitte!</p></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".spalte",
              "property": "max-width",
              "value": "280px",
              "hint": "Begrenze die Breite: max-width: 280px;"
            },
            {
              "selector": ".spalte",
              "property": "margin-left",
              "notValue": "0px",
              "hint": "Zentriere die Box mit margin: 0 auto;"
            }
          ]
        }
      },
      {
        "instruction": "Zentriere in der Box auch den Text – aber nur die Überschrift, nicht den Absatz.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      max-width: 280px;\n      margin: 0 auto;\n      background-color: mistyrose;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><h2>Termine</h2><p>Montag, Mittwoch und Freitag.</p></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .spalte {\n      max-width: 280px;\n      margin: 0 auto;\n      background-color: mistyrose;\n    }\n    .spalte h2 {\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"spalte\"><h2>Termine</h2><p>Montag, Mittwoch und Freitag.</p></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".spalte h2",
              "property": "text-align",
              "value": "center",
              "hint": "Schreib eine Regel für die Überschrift in der Box: .spalte h2 { text-align: center; }"
            },
            {
              "selector": ".spalte p",
              "property": "text-align",
              "value": "start",
              "hint": "Der Absatz soll linksbündig bleiben – zentriere nur die Überschrift."
            }
          ]
        }
      }
    ]
  },
  {
    "id": "lektion-04",
    "section": "lektion",
    "title": "Positionierung",
    "file": "lektion-04.md",
    "lessonSummary": "Präzise! Mit relative und absolute setzt du Elemente genau an ihre Stelle.",
    "tasks": [
      {
        "instruction": "Führe das Beispiel aus: Das Abzeichen „Neu!“ sitzt oben rechts in der Karte.",
        "example": true,
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      position: relative;\n      max-width: 260px;\n      padding: 16px;\n      border: 2px solid slateblue;\n    }\n    .abzeichen {\n      position: absolute;\n      top: 0;\n      right: 0;\n      background-color: gold;\n      padding: 4px 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\"><span class=\"abzeichen\">Neu!</span><h3>Skatepark</h3><p>Ab Juni geöffnet.</p></div>\n</body>\n</html>\n",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".abzeichen",
              "property": "position",
              "value": "absolute"
            }
          ]
        }
      },
      {
        "instruction": "Setz das Abzeichen mit class=\"preis\" in die Ecke oben links der Karte: die Karte wird Bezugspunkt, das Abzeichen wird absolut positioniert.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      max-width: 260px;\n      padding: 30px 16px 16px;\n      border: 2px solid seagreen;\n    }\n    .preis {\n      background-color: tomato;\n      color: white;\n      padding: 4px 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\"><span class=\"preis\">-20 %</span><h3>Fahrradhelm</h3><p>Nur diese Woche.</p></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      position: relative;\n      max-width: 260px;\n      padding: 30px 16px 16px;\n      border: 2px solid seagreen;\n    }\n    .preis {\n      position: absolute;\n      top: 0;\n      left: 0;\n      background-color: tomato;\n      color: white;\n      padding: 4px 8px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"karte\"><span class=\"preis\">-20 %</span><h3>Fahrradhelm</h3><p>Nur diese Woche.</p></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".karte",
              "property": "position",
              "value": "relative",
              "hint": "Die Karte braucht position: relative; als Bezugspunkt."
            },
            {
              "selector": ".preis",
              "property": "position",
              "value": "absolute",
              "hint": "Das Abzeichen braucht position: absolute;"
            },
            {
              "selector": ".preis",
              "property": "top",
              "value": "0px",
              "hint": "Setz das Abzeichen nach oben: top: 0;"
            },
            {
              "selector": ".preis",
              "property": "left",
              "value": "0px",
              "hint": "Setz das Abzeichen nach links: left: 0;"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "debug-01",
    "section": "debug",
    "title": "Fehlersuche: Boxen",
    "file": "debug-01.md",
    "lessonSummary": "Repariert! Zu breite Boxen und ausgebüxte Abzeichen bringst du jetzt in Ordnung.",
    "tasks": [
      {
        "instruction": "Die Eingabebox ragt rechts über den Rand. Sorge dafür, dass Innenabstand und Rahmen in die 100 % hineinzählen.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .suche {\n      width: 100%;\n      padding: 12px;\n      border: 3px solid steelblue;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"suche\">Suchbegriff …</div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .suche {\n      box-sizing: border-box;\n      width: 100%;\n      padding: 12px;\n      border: 3px solid steelblue;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"suche\">Suchbegriff …</div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".suche",
              "property": "box-sizing",
              "value": "border-box",
              "hint": "Es fehlt box-sizing: border-box; – sonst kommen padding und border zur Breite dazu."
            }
          ]
        }
      },
      {
        "instruction": "Die Box soll in der Mitte stehen, tut es aber nicht. Gib ihr eine maximale Breite von 250px.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .mitte {\n      margin: 0 auto;\n      background-color: lavender;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"mitte\">Ich will in die Mitte.</div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .mitte {\n      max-width: 250px;\n      margin: 0 auto;\n      background-color: lavender;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"mitte\">Ich will in die Mitte.</div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".mitte",
              "property": "max-width",
              "value": "250px",
              "hint": "margin: 0 auto braucht eine schmalere Box: max-width: 250px;"
            }
          ]
        }
      },
      {
        "instruction": "Das Abzeichen „Top“ landet in der Ecke der ganzen Seite statt in der Karte. Repariere das.",
        "codeTemplate": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      margin-top: 40px;\n      padding: 20px;\n      border: 2px solid orange;\n    }\n    .top {\n      position: absolute;\n      top: 0;\n      right: 0;\n      background-color: orange;\n    }\n  </style>\n</head>\n<body>\n  <p>Ein Absatz vor der Karte.</p>\n  <div class=\"karte\"><span class=\"top\">Top</span><h3>Pizza Salami</h3></div>\n</body>\n</html>\n",
        "solution": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Meine Website</title>\n  <style>\n    .karte {\n      position: relative;\n      margin-top: 40px;\n      padding: 20px;\n      border: 2px solid orange;\n    }\n    .top {\n      position: absolute;\n      top: 0;\n      right: 0;\n      background-color: orange;\n    }\n  </style>\n</head>\n<body>\n  <p>Ein Absatz vor der Karte.</p>\n  <div class=\"karte\"><span class=\"top\">Top</span><h3>Pizza Salami</h3></div>\n</body>\n</html>",
        "validation": {
          "type": "web",
          "checks": [
            {
              "selector": ".karte",
              "property": "position",
              "value": "relative",
              "hint": "Die Karte braucht position: relative; – sonst richtet sich das Abzeichen an der Seite aus."
            }
          ]
        }
      }
    ]
  },
